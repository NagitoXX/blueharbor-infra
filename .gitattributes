# Line endings: text files are stored with LF in the repository.
* text=auto

# Files that run or are read on Linux servers must keep LF on every checkout,
# including Windows (core.autocrlf=true would otherwise turn them into CRLF).
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.j2        text eol=lf
*.cfg       text eol=lf
Dockerfile  text eol=lf

# Windows PowerShell scripts
*.ps1       text eol=crlf

# Binary files
*.pkt       binary
*.png       binary
*.jpg       binary
*.docx      binary
*.pdf       binary
# GPO reports exported by Windows are UTF-16
lab02/evidence/*.html binary
